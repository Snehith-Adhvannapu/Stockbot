# Stock Trading Platform Environment Variables
# Copy this file to .env and fill in your API keys

# Alpaca API Keys (for paper trading)
# Get your free paper trading keys from: https://alpaca.markets
# Sign up -> Paper Trading -> API Keys
ALPACA_API_KEY=your_alpaca_api_key_here
ALPACA_SECRET_KEY=your_alpaca_secret_key_here

# NewsAPI Key (for sentiment analysis)
# Get your free key from: https://newsapi.org
# Free tier: 100 requests/day
NEWS_API_KEY=your_newsapi_key_here

# Optional: OpenAI API Key (if using AI features)
# OPENAI_API_KEY=your_openai_key_here
