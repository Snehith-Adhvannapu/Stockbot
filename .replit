modules = ["python-3.11"]

[nix]
channel = "stable-25_05"
packages = ["glibcLocales"]

[deployment]
deploymentTarget = "autoscale"
run = ["streamlit", "run", "app.py", "--server.port", "5000"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Stock Advisor App"

[[workflows.workflow]]
name = "Stock Advisor App"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "streamlit run app.py --server.port 5000 --server.address 0.0.0.0"
waitForPort = 5000

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 37287
externalPort = 3000

[[ports]]
localPort = 38493
externalPort = 3002

[[ports]]
localPort = 41185
externalPort = 4200

[[ports]]
localPort = 43129
externalPort = 3001

[[ports]]
localPort = 44863
externalPort = 3003

[agent]
expertMode = true
